# Configuration names only. Configure real values in the appropriate private runtime.
# Sites backend, never browser-visible NEXT_PUBLIC variables:
DUGOUT_RUNNER_URL=
DUGOUT_RUNNER_SECRET=
# Sites identity allowed to set up the background runner and use paid adviser chat.
# Must match the native Worker's RUNNER_OWNER_ID. Guests retain browser paper mode.
DUGOUT_OWNER_ID=
ANTHROPIC_API_KEY=
# Optional market stream credentials; public REST is a read-only fallback.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Native Cloudflare runner, configured on that Worker:
# RUNNER_HMAC_SECRET must equal Sites DUGOUT_RUNNER_SECRET.
RUNNER_HMAC_SECRET=
RUNNER_OWNER_ID=
RUNNER_ENGINE_VERSION=

# Optional connection to the separate Node read-only stream service:
TRADING_SERVICE_URL=
TRADING_SERVICE_TOKEN=
# Standalone Node listener, not the background paper engine:
TRADING_SERVICE_HOST=127.0.0.1
TRADING_SERVICE_PORT=4179
TRADING_STREAM_IDLE_TIMEOUT_MS=60000

# Decision engine evidence pack (docs/DATA-PLATFORM.md). Optional: without a URL the bundled pack is used.
# The SHA-256 pin is what lets a streamed pack's "proven" rows count; unpinned packs cannot enable real money.
DUGOUT_EVIDENCE_PACK_URL=
DUGOUT_EVIDENCE_PACK_SHA256=

# Research data lake credentials belong in research/.env on the research PC, never here:
# R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_PUBLIC_BASE, LAKE_PREFIX
